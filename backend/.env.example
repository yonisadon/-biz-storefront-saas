PORT=3000
# MUST be the app_runtime user, NOT Railway's default postgres URL
APP_DATABASE_URL=postgresql://app_runtime:PASSWORD@HOST:5432/railway
DATABASE_SSL=false
MEDIA_BASE_URL=http://localhost:4000
CORS_ORIGINS=https://platform.example
# Registry DB access for the Super Admin API and token issuance.
SUPERADMIN_DATABASE_URL=postgresql://app_superadmin:PASSWORD@HOST:5432/railway
# Must be a PostgreSQL owner/CREATEDB-capable connection to the same Railway PostgreSQL service.
# Never use this URL for ordinary application requests.
DATABASE_ADMIN_URL=postgresql://postgres:PASSWORD@HOST:5432/railway
# Generate a long random secret (at least 32 characters); enter it only on /platform-admin.
SUPERADMIN_API_TOKEN=replace-with-a-long-random-secret-at-least-32-chars
PUBLIC_BASE_URL=https://platform.example

# Optional Google Calendar integration (set in Railway; never commit real secrets).
# GOOGLE_OAUTH_CLIENT_ID=your-web-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-web-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/google-calendar/callback
# GOOGLE_OAUTH_STATE_SECRET=generate-a-random-secret-at-least-32-characters
# GOOGLE_TOKEN_ENCRYPTION_KEY=64-hex-characters-for-a-32-byte-AES-256-key

# --- חדש שנוסף עבור אחסון תמונות (Storage) ---
STORAGE_DRIVER=local          # שים "s3" ב-Railway, ו-"local" בסביבת טסט מקומית
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT=                  # השאר ריק עבור AWS S3, או שים את הכתובת ל-R2/MinIO
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true